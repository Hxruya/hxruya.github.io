---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<header class="mx-auto max-w-5xl px-4 pt-16 sm:px-6 sm:pt-24">
  <p class="font-mono text-sm text-accent">{eyebrow}</p>
  <h1 class="mt-2 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{title}</h1>
  {intro && <p class="mt-4 max-w-2xl text-lg text-muted text-pretty">{intro}</p>}
</header>
