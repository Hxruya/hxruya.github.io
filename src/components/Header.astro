---
import { nav, site } from "@/data/site";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="sticky top-0 z-40 border-b border-border/70 bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="font-mono text-sm font-semibold tracking-tight">
      <span class="text-accent">~/</span>{site.name.toLowerCase()}
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="rounded-md px-3 py-2 text-sm text-muted transition-colors hover:bg-accent-soft hover:text-fg">
              {item.label}
            </a>
          </li>
        ))}
        <li class="ml-2"><ThemeToggle /></li>
      </ul>
    </nav>

    <div class="flex items-center gap-1 lg:hidden">
      <ThemeToggle />
      <button
        type="button"
        popovertarget="mobile-nav"
        class="rounded-md p-2 text-muted hover:bg-accent-soft hover:text-fg"
        aria-label="Open menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    popover
    aria-label="Mobile"
    class="inset-x-4 top-18 m-0 w-auto rounded-xl border border-border bg-surface p-2 text-fg shadow-xl backdrop:bg-black/20"
  >
    <ul class="flex flex-col">
      {nav.map((item) => (
        <li>
          <a href={item.href} class="block rounded-md px-3 py-3 hover:bg-accent-soft" data-close-menu>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  // Close the mobile menu after picking a link.
  document.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("[data-close-menu]")) {
      document.getElementById("mobile-nav")?.hidePopover();
    }
  });
</script>
