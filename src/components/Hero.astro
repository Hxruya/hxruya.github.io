---
import { site } from "@/data/site";
---

<section class="relative overflow-hidden">
  <div aria-hidden="true" class="pointer-events-none absolute -top-40 left-1/2 h-96 w-[48rem] -translate-x-1/2 rounded-full bg-accent/15 blur-3xl"></div>
  <div class="relative mx-auto max-w-5xl px-4 pt-20 pb-16 sm:px-6 sm:pt-32 sm:pb-24">
    <p class="font-mono text-sm text-accent">Hi, I'm {site.name} 👋</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
      {site.role}
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-muted text-pretty">{site.tagline}</p>
    <p class="mt-3 font-mono text-sm text-muted">{site.location}</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="#projects" class="rounded-lg bg-accent px-5 py-3 text-sm font-medium text-bg transition hover:opacity-90">See my work</a>
      <a href="#contact" class="rounded-lg border border-border px-5 py-3 text-sm font-medium transition hover:border-accent hover:text-accent">Get in touch</a>
      {site.resumeUrl && (
        <a href={site.resumeUrl} class="rounded-lg border border-border px-5 py-3 text-sm font-medium transition hover:border-accent hover:text-accent">Résumé</a>
      )}
    </div>
  </div>
</section>
