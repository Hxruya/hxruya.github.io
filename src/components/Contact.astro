---
import Section from "./Section.astro";
import { site } from "@/data/site";
---

<Section id="contact" eyebrow="04 · Contact" title="Let's talk" intro="Open to opportunities and interesting conversations. The fastest way to reach me is email.">
  <div class="flex flex-wrap gap-3">
    <a href={`mailto:${site.email}`} class="rounded-lg bg-accent px-5 py-3 text-sm font-medium text-bg transition hover:opacity-90">{site.email}</a>
    {site.socials.map((s) => (
      <a href={s.href} target="_blank" rel="noopener" class="rounded-lg border border-border px-5 py-3 text-sm font-medium transition hover:border-accent hover:text-accent">{s.label} ↗</a>
    ))}
  </div>
</Section>
