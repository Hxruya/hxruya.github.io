---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import Section from "@/components/Section.astro";
import { Image } from "astro:assets";
import { gaming } from "@/data/gaming";

const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

<Base title="Gaming" description="Competitive gaming achievements: ranks, seasons and milestones.">
  <PageHeader
    eyebrow="~/gaming"
    title="Gaming"
    intro="Ranked play rewards the same things good engineering does: reviewing what went wrong, adapting quickly and communicating with a team."
  />

  <Section id="ranked" eyebrow="01 · Ranked" title="Competitive highlights">
    <div class="grid gap-4 md:grid-cols-2">
      {gaming.map((g) => (
        <article class:list={["flex flex-col rounded-2xl border border-border bg-surface p-6 transition hover:-translate-y-0.5 hover:border-accent/50 hover:shadow-lg hover:shadow-accent/5", g.featured && "md:col-span-2"]}>
          <header class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h3 class="text-lg font-semibold">{g.game}</h3>
              <p class="font-mono text-xs text-muted">{[g.genre, g.platform, g.region].filter(Boolean).join(" · ")}</p>
            </div>
            {g.badge && <span class="rounded-md bg-accent-soft px-2 py-0.5 font-mono text-xs text-accent">{g.badge}</span>}
          </header>
          <dl class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3">
            <div>
              <dt class="font-mono text-xs text-muted">Peak rank</dt>
              <dd class="mt-1 text-xl font-semibold text-accent">{g.peakRank}</dd>
            </div>
            <div>
              <dt class="font-mono text-xs text-muted">Mode</dt>
              <dd class="mt-1">{g.mode}</dd>
            </div>
            {g.peakRating && (
              <div>
                <dt class="font-mono text-xs text-muted">Peak rating</dt>
                <dd class="mt-1">{g.peakRating}</dd>
              </div>
            )}
            {g.leaderboard && (
              <div>
                <dt class="font-mono text-xs text-muted">Leaderboard</dt>
                <dd class="mt-1">{g.leaderboard}</dd>
              </div>
            )}
            {g.years && (
              <div>
                <dt class="font-mono text-xs text-muted">Played</dt>
                <dd class="mt-1">{g.years}</dd>
              </div>
            )}
          </dl>
          {g.rankNote && (
            <p class="mt-5 rounded-lg border-l-2 border-accent bg-accent-soft/40 px-3 py-2 text-sm text-muted text-pretty">{g.rankNote}</p>
          )}
          <ul class="mt-5 list-disc space-y-1 pl-5 text-muted marker:text-accent">
            {g.milestones.map((m) => <li>{m}</li>)}
          </ul>
          {g.screenshots?.length && (
            <>
              <button
                type="button"
                commandfor={`shots-${slug(g.game)}`}
                command="show-modal"
                class="mt-5 self-start text-sm font-medium hover:text-accent"
              >
                View {g.screenshots.length > 1 ? `${g.screenshots.length} screenshots` : "screenshot"} →
              </button>
              <dialog
                id={`shots-${slug(g.game)}`}
                closedby="any"
                aria-label={`${g.game} screenshots`}
                class="m-auto max-h-[92dvh] w-[min(64rem,94vw)] max-w-none rounded-xl border border-border bg-surface p-0 text-fg shadow-2xl backdrop:bg-black/70 backdrop:backdrop-blur-sm"
              >
                <ul class="flex snap-x snap-mandatory overflow-x-auto overscroll-contain" aria-label="Screenshots">
                  {g.screenshots.map((shot, i) => (
                    <li class="w-full shrink-0 snap-center">
                      <figure>
                        <Image src={shot.src} alt={shot.alt} widths={[640, 1024, 1600]} sizes="(min-width: 1100px) 1024px, 94vw" loading="lazy" class="h-auto max-h-[78dvh] w-full object-contain" />
                        <figcaption class="px-4 pt-3 text-sm text-muted">
                          {g.screenshots!.length > 1 && <span class="font-mono text-xs text-accent">{i + 1}/{g.screenshots!.length} · </span>}
                          {shot.alt}
                        </figcaption>
                      </figure>
                    </li>
                  ))}
                </ul>
                <div class="flex items-center justify-between gap-4 px-4 py-3">
                  <p class="text-xs text-muted">{g.screenshots.length > 1 ? "Swipe or scroll sideways for more" : ""}</p>
                  <button type="button" commandfor={`shots-${slug(g.game)}`} command="close" class="rounded-md px-3 py-1.5 text-sm hover:bg-accent-soft">Close</button>
                </div>
              </dialog>
            </>
          )}
        </article>
      ))}
    </div>
  </Section>
</Base>
